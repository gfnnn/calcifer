# ---------------------------------------------------------------------------
# From the Ashes — guild member database bot
# Copy this file to ".env" and fill in the values.
# ---------------------------------------------------------------------------

# --- Discord (required to run the bot) -------------------------------------
# Create an application + bot at https://discord.com/developers/applications
# and paste the bot token here.
DISCORD_TOKEN=

# Optional: restrict slash-command registration to a single server (guild) so
# new commands show up instantly instead of waiting ~1h for global sync.
# This is your Discord server ID, NOT the WoW guild.
DISCORD_GUILD_ID=

# Optional: Discord role name allowed to run admin commands (/sync, /note, ...).
# Anyone with this role OR "Manage Server" permission qualifies.
ADMIN_ROLE_NAME=Officer

# Optional: the GM's Discord user ID, so Calcifer addresses Harry in his own
# (familiar, contract-bound) register, distinct from officers and members.
GM_DISCORD_ID=

# Master switch for the bot's slash commands. Set to 0 on production to disable
# all slash commands (cogs aren't loaded and registered commands are cleared).
# The bot still logs in and runs presence/feeds. Defaults to enabled.
BOT_COMMANDS_ENABLED=1

# --- WoW guild identity (defaults for every command) -----------------------
GUILD_NAME=From the Ashes
GUILD_REALM=hellfire
GUILD_REGION=eu

# Guild-management tuning.
# Members whose guild rank index is <= this are treated as officers (0 = GM).
OFFICER_RANK_MAX=2
# A character counts as "active" if seen within this many days.
ACTIVITY_WINDOW_DAYS=14

# Sync performance. Skip re-enriching a member whose stored stats were refreshed
# within this many hours (0 = always enrich). On a persistent deploy this makes
# repeat syncs near-instant. Raiders are always enriched first when stale.
ENRICH_MAX_AGE_HOURS=12
# Optionally cap how many stale non-raiders are deep-enriched per run (0 = no
# cap). Useful for a large guild on the free Raider.IO API: the long tail then
# refreshes oldest-first across successive syncs.
ENRICH_LIMIT=0
# Concurrent Raider.IO enrichment requests during a sync. Low by default to stay
# gentle on memory and rate limits on small hosts; raise it for faster syncs on
# a beefier instance.
ENRICH_CONCURRENCY=2

# Where the SQLite database lives.
DATABASE_PATH=ftabot.db

# --- Browser query layer (the web app) -------------------------------------
WEB_HOST=0.0.0.0
# Most cloud hosts inject $PORT automatically; WEB_PORT is the local fallback.
WEB_PORT=8080

# All-in-one runner (python -m ftabot.serve): auto-refresh the roster every N
# minutes. 0 disables it (use /sync or the CLI instead). Good default: 360 (6h).
SYNC_INTERVAL_MINUTES=0

# Secret that unlocks the browser "Sync now" trigger at /admin?token=...
# Leave blank to disable the web trigger (Discord /sync + CLI still work).
SYNC_TOKEN=

# Send the sync-token cookie only over HTTPS (Secure flag). On by default;
# set to 0 only for local http:// development.
COOKIE_SECURE=1

# Shared secret for the data-spine upload endpoint (POST /api/upload/savedvars),
# where the GM's companion uploader pushes RCLootCouncil / GRM SavedVariables.
# Leave blank to disable the upload route. See scripts/upload_savedvars.py.
SAVEDVARS_UPLOAD_SECRET=

# --- WoW Audit API (PRIMARY source of truth — paid per-team key) -----------
# Team admins find the key under team Settings -> API on wowaudit.com.
# When set, WoW Audit drives the roster (gear, vault, wishlist, parses) and the
# other APIs are used only to fill gaps.
WOWAUDIT_API_KEY=
WOWAUDIT_BASE_URL=https://wowaudit.com/v1

# --- Blizzard API (OPTIONAL — enriches rank / race / level / equipment) ----
# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --- Warcraft Logs API (OPTIONAL — raid parse averages) --------------------
# Create a v2 client at https://www.warcraftlogs.com/api/clients/
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=
# The raid tier (zone) is auto-detected from the API — the current tier is the
# newest raid zone in the latest expansion, so it follows each season with no
# action needed. Set WARCRAFTLOGS_ZONE_ID only to pin a specific historical
# tier (see https://www.warcraftlogs.com/zones/list).
WARCRAFTLOGS_ZONE_ID=

# --- Recruitment scout (/scout) --------------------------------------------
# The scout finds upgrades for the team's weak slots, like-for-like by class.
# It DISCOVERS candidates via Warcraft Logs parse rankings, so it needs the
# WARCRAFTLOGS_* credentials above plus one or more tier zone IDs.
#
# Tier zones (oldest -> newest, comma-separated) the scout reads parse history
# from; the newest is scanned for candidates. Falls back to WARCRAFTLOGS_ZONE_ID
# when unset. e.g. WARCRAFTLOGS_ZONE_IDS=38,42,44
WARCRAFTLOGS_ZONE_IDS=
# Raider.IO season slugs (oldest -> newest) for the M+ trajectory. These change
# each expansion/tier — see a character's profile on raider.io for the slugs.
RECRUIT_SEASONS=season-tww-1,season-tww-2,season-tww-3
# Hard floor from your live recruitment profile.
RECRUIT_MIN_ITEM_LEVEL=275
# Roles you are recruiting (comma-separated).
RECRUIT_ROLES_OPEN=TANK,HEALER,DPS
# A roster slot counts as "weak" (worth scouting) below this team percentile.
RECRUIT_WEAK_THRESHOLD=0.4

# --- Posting guardrail (deny-by-default; protects every outbound message) --
# The master switch for ALL of Calcifer's posting (boards and feed alerts):
#   off   = post nothing, anywhere (default; the bot is mute).
#   test  = redirect every post to TEST_CHANNEL_ID; production never receives it.
#   live  = promoted boards reach their real channel; the rest stay sandboxed.
# Workflow: off (safe) -> set TEST_CHANNEL_ID + test (review in private) ->
# live + promote a board with /board promote (only then is it seen by members).
POSTING_MODE=off
# The confirmed sandbox channel test/un-promoted posts land in (a private
# officer channel ID). Posts are only sent once this is set.
TEST_CHANNEL_ID=

# --- Living boards (Calcifer's self-updating pages) ------------------------
# Re-render bot-owned board messages (e.g. Calcifer's Hot 20) every N minutes,
# editing each in place rather than re-posting. 0 disables the board loop.
# Needs DISCORD_TOKEN; boards are created/placed with the /board command.
BOARD_REFRESH_MINUTES=0
# Recurring refresh of the active key-runners' Mythic+ scores (raiders + top
# scorers, capped by MPLUS_FEED_MEMBER_CAP), then nudge the boards. Keeps the
# Hot 20 fresh without polling all ~300 chars. 0 = off. Members can also force
# their own with /refreshme.
SCORE_REFRESH_MINUTES=0

# --- Integration hub / Calcifer feeds --------------------------------------
# Poll external feeds (Wowhead news, …) every N minutes. 0 disables the feed
# loop. The loop runs inside the all-in-one process and posts via the bot, so it
# needs DISCORD_TOKEN set and a destination channel below.
FEED_POLL_MINUTES=0
# Channel that catches feed alerts with no specific routing rule. This is your
# Discord *channel* ID (enable Developer Mode, right-click the channel -> Copy ID).
# Point this at e.g. your #wow-news channel to replace PatchBot.
FEED_DEFAULT_CHANNEL_ID=
# Calcifer's flavour intensity: off / light / full.
PERSONA_TONE=light
# Wowhead news RSS feed (blue posts / patch notes / general WoW news).
WOWHEAD_RSS_URL=https://www.wowhead.com/news/rss/all
# Set to 0 to disable the Wowhead source while keeping the feed loop running.
WOWHEAD_ENABLED=1

# Blizzard official news RSS: a second source archived into the News board's
# top zone alongside Wowhead. Point the URL at a different feed (e.g. the
# all-Blizzard feed) if you prefer; set ENABLED to 0 to turn it off.
BLIZZARD_NEWS_ENABLED=1
BLIZZARD_NEWS_RSS_URL=https://news.blizzard.com/en-us/world-of-warcraft/rss

# Raider.IO Mythic+ feed: announce the guild's timed high keys. Off by default
# because it polls many characters each pass. Set to 1 to enable.
MPLUS_FEED_ENABLED=0
# Only announce timed keys at/above this level.
MPLUS_ALERT_MIN_LEVEL=18
# Cap how many characters are polled per pass (raiders are polled first).
MPLUS_FEED_MEMBER_CAP=40

# --- Raid-Helper webhook (push: event created / updated / deleted) ---------
# Raid-Helper POSTs to  POST /webhooks/raidhelper  on your public URL. Set a
# shared secret here and configure the same value on the Raid-Helper side; the
# receiver rejects anything that doesn't match (passed as ?token= or X-Signature).
RAIDHELPER_WEBHOOK_SECRET=
# Where event mirrors post (falls back to FEED_DEFAULT_CHANNEL_ID). Channel ID.
RAIDHELPER_DEFAULT_CHANNEL_ID=
# Optional: Raid-Helper REST API for backfill (not required for the webhook).
RAIDHELPER_API_KEY=
RAIDHELPER_SERVER_ID=

# --- WoW Audit raid reminders (needs WOWAUDIT_API_KEY) ---------------------
# Nudge the guild before a scheduled raid night, with the sign-up count.
RAID_REMINDER_ENABLED=0
# Remind when a raid starts within this many hours.
RAID_REMINDER_WINDOW_HOURS=6
# WoW Audit reports raid times in the team's local timezone. RAID_TZ is that
# zone as an IANA name, so it tracks DST automatically across the CET<->CEST
# switch (no hour of drift for half the year). This is the server timezone every
# time-anchored surface computes "this week" / "next raid" against. A fixed
# offset, if you ever need one, is itself a zone name (e.g. Etc/GMT-2 = UTC+2).
RAID_TZ=Europe/Paris

# --- Warcraft Logs live-prog feed (the Wipefest role; needs WCL creds) -----
# Summarise the latest log's best pull per boss + kills during progression.
PROG_FEED_ENABLED=0
# Only announce wipes at/under this boss-health %% (stay quiet on early pulls).
PROG_ALERT_THRESHOLD=30

# --- YouTube channel uploads (keyless Atom feed per channel) ---------------
# Post new videos from one or more channels (e.g. the guild's own channel for
# raid VODs). Find a channel id in the channel page source ("channelId", UC...).
YOUTUBE_FEED_ENABLED=0
# Comma-separated channel ids (UC...). Leave empty to keep the source off.
YOUTUBE_CHANNEL_IDS=

# --- WoWProgress guild ranking (JSON; no RSS exists) -----------------------
# Announce OUR guild's WoWProgress world/realm rank movement, from their JSON
# Data Export. Uses GUILD_NAME/GUILD_REALM/GUILD_REGION. Per WoWProgress's terms
# every posted alert links back to and credits WoWProgress.com (handled in code).
WOWPROGRESS_FEED_ENABLED=0
# Optional: pin a tier/rating (e.g. tier35 or tier8.ach). Unset = overall rank.
WOWPROGRESS_RATING=
